# ===== 模型服务商（均为 OpenAI 兼容接口）=====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 角色 -> provider:model（换模型只改这里，不改代码）=====
# 全免费三模型分工：便宜文本档 / 视觉档 / 强文本档(裁判)
# 免费清单/价格以控制台实时为准: https://docs.bigmodel.cn/cn/guide/start/pricing#-1
MODEL_DECOMPOSE=zhipu:glm-4-flash
MODEL_FORENSICS=zhipu:glm-4.6v-flash
MODEL_PROSECUTOR=zhipu:glm-4-flash
MODEL_DEFENDER=zhipu:glm-4-flash
MODEL_JUDGE=zhipu:glm-4.7-flash
# 想要更强裁决可改付费档(约¥0.003-0.005/条,需充值): MODEL_JUDGE=zhipu:glm-5.3-flash
# 置信度路由：初筛裁判置信度低于阈值时升级强裁判(仍可全免费)
MODEL_JUDGE_STRONG=zhipu:glm-4.5-flash
ENABLE_ESCALATION=true
JUDGE_CONFIDENCE_THRESHOLD=0.6

# ===== LLM 客户端行为 =====
# off: 不缓存 | readwrite: 读穿写穿（默认） | replay: 只读录制，未命中报错
LLM_CACHE_MODE=readwrite
LLM_CACHE_DIR=.cache/llm
LLM_MAX_CONCURRENCY=1
# 单次调用的重试预算（429/超时/5xx 共用）；默认 3，别再 6 次 ×120s 把免费档冷却期耗尽
LLM_MAX_RETRIES=3
# 按角色单独设置重试预算（覆盖 LLM_MAX_RETRIES）。JSON，键为角色名
# 例：{"forensics":1,"judge":2} —— 视觉档/裁判档限流多，重试少；便宜文本档可多试
LLM_RETRY_BUDGETS={}
LLM_MIN_INTERVAL_SECONDS=2
# 429(免费档账户级冷却)专用长退避起步秒数，指数翻倍
LLM_RATE_LIMIT_BACKOFF_SECONDS=15
# 退避上限（秒）：指数增长与 Retry-After 都封顶到它，避免单次调用卡几分钟
LLM_RATE_LIMIT_BACKOFF_MAX_SECONDS=60
# 熔断：同一模型连续 N 次 429 就跳过该模型（进程内），冷却 M 秒后再试
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=300
# 兜底候选链：主模型限流/熔断/超时重试耗尽时按顺序切换。JSON，键为角色名，值为 provider:model 数组
# 例（2026-11 体检实测可达）：{"judge":["zhipu:glm-4.5-flash","siliconflow:zai-org/GLM-4.5-Air"],
#                              "forensics":["siliconflow:Qwen/Qwen3-VL-8B-Instruct"]}
# 跨平台兜底需要自己填 SILICONFLOW_API_KEY（免费档），各平台配额池独立，互不拖累
# 视觉备胎请选通用 VLM（能输出取证 JSON），纯 OCR 型号回不了 {ocr_text, claims[]} 结构
LLM_ROLE_FALLBACKS={}
LLM_TIMEOUT_SECONDS=60

# ===== 证据检索（Tavily 免费档 1000 次/月，https://tavily.com 注册）=====
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RETRIEVE_TOP_K=3
RETRIEVE_MAX_CLAIMS=5
# 组件消融开关：关掉检索/辩论做免费消融实验
ENABLE_RETRIEVAL=true
ENABLE_DEBATE=true
# LangGraph 编排开关：true 走 StateGraph（支持循环多轮辩论），false 走手写直线 runner（可 A/B 回退）
ENABLE_LANGGRAPH=false
# LangGraph 检查点（M2）：true 时 AsyncSqliteSaver 按 thread_id 持久化超步，崩溃/中断后同 thread_id 续跑
# 仅 ENABLE_LANGGRAPH=true 时生效；默认 false 零开销
ENABLE_CHECKPOINT=false
CHECKPOINT_PATH=.data/langgraph_checkpoints.sqlite
# HITL 人工介入（M3）：true 时裁决弃权或低置信（<JUDGE_CONFIDENCE_THRESHOLD）会 interrupt 暂停，
# 前端弹出复核面板，POST /api/verify/{id}/resume 注入人工裁决后续跑；隐含启用检查点
ENABLE_HITL=false
# 辩论最大轮数：1=现行为；>1 启用控辩裁循环，judge 低置信且未达上限则进入下一轮
DEBATE_MAX_ROUNDS=1
# 事后置信度校准：true 时按 CALIBRATOR_PATH 的温度缩放上报置信度（路由/升级仍用原始 conf）
# 先跑 scripts.calibrate 拟合生成 artifact；缺失时 T=1.0 静默不校准
ENABLE_CALIBRATION=false
CALIBRATOR_PATH=.data/calibrator.json
TRACE_DIR=.data/traces

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
# ===== 模型服务商（均为 OpenAI 兼容接口）=====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 角色 -> provider:model（换模型只改这里，不改代码）=====
# 全免费三模型分工：便宜文本档 / 视觉档 / 强文本档(裁判)
# 免费清单/价格以控制台实时为准: https://docs.bigmodel.cn/cn/guide/start/pricing#-1
MODEL_DECOMPOSE=zhipu:glm-4-flash
MODEL_FORENSICS=zhipu:glm-4.6v-flash
MODEL_PROSECUTOR=zhipu:glm-4-flash
MODEL_DEFENDER=zhipu:glm-4-flash
MODEL_JUDGE=zhipu:glm-4.7-flash
# 想要更强裁决可改付费档(约¥0.003-0.005/条,需充值): MODEL_JUDGE=zhipu:glm-5.3-flash
# 置信度路由：初筛裁判置信度低于阈值时升级强裁判(仍可全免费)
MODEL_JUDGE_STRONG=zhipu:glm-4.5-flash
ENABLE_ESCALATION=true
JUDGE_CONFIDENCE_THRESHOLD=0.6

# ===== LLM 客户端行为 =====
# off: 不缓存 | readwrite: 读穿写穿（默认） | replay: 只读录制，未命中报错
LLM_CACHE_MODE=readwrite
LLM_CACHE_DIR=.cache/llm
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=6
LLM_MIN_INTERVAL_SECONDS=2
# 429(免费档账户级冷却)专用长退避起步秒数，指数翻倍封顶120s
LLM_RATE_LIMIT_BACKOFF_SECONDS=15
LLM_TIMEOUT_SECONDS=60

# ===== 证据检索（Tavily 免费档 1000 次/月，https://tavily.com 注册）=====
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RETRIEVE_TOP_K=3
RETRIEVE_MAX_CLAIMS=5
# 组件消融开关：关掉检索/辩论做免费消融实验
ENABLE_RETRIEVAL=true
ENABLE_DEBATE=true
TRACE_DIR=.data/traces

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000